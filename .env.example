# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for app_settings (API keys stored in DB)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-min-32-chars

# These are managed via the Admin Settings UI in the app
# and stored encrypted in Supabase — NOT in env vars:
# - Lodgify API Key
# - Gmail OAuth credentials
# - Green Invoice API Key
# - AI API Key (for bill parsing)

# Email (Resend)
RESEND_API_KEY=your-resend-key

# Magic link JWT signing secret (separate from Supabase keys)
# Generate with: openssl rand -base64 32
MAGIC_LINK_SECRET=your-magic-link-secret-min-32-chars

# Cron job authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# AI — Bill parsing (Claude Sonnet via OpenRouter, falls back to Gemini)
OPENROUTER_API_KEY=your-openrouter-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
